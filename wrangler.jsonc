{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proud-de",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PDFS_BUCKET",
      "bucket_name": "proud-preview-pdfs"
    }
  ],
  "routes": [
    {
      "pattern": "proud.xn--wp9h.tk",
      "zone_id": "eea4baf8b174105aa0a9774651274c90",
      "custom_domain": true
    }
  ]
}
